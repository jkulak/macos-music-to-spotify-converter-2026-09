# Copy to .env (never committed) and fill in.

# Client ID of your app at https://developer.spotify.com/dashboard
# (redirect URI registered there: http://127.0.0.1:8888/callback).
SPOTIFY_CLIENT_ID=

# Country whose catalogue is searched; tracks not playable there count as missing.
SPOTIFY_MARKET=PL

# Pause between Spotify requests, in seconds, and the longest Retry-After to wait
# out; a longer one stops the run (Spotify answers bursts with bans of hours).
SPOTIFY_MIN_INTERVAL=0.35
SPOTIFY_MAX_RETRY_WAIT=120

# Playlist names: "path" prefixes each with its folder path ("Added / 2013 / Mix")
# until it has been moved into that Spotify folder; "plain" then drops the prefix.
PLAYLIST_NAMES=path
# The Spotify folder that holds everything, named in plan.md's checklist.
ROOT_FOLDER=mp3-collection

# Where snapshots, tokens and caches live, and where reports are written.
# Inside Docker these are overridden to /app/data and /app/reports.
DATA_DIR=data
REPORTS_DIR=reports
