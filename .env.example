# Copy to .env (never committed) and fill in.

# Client ID of your app at https://developer.spotify.com/dashboard
# (redirect URI registered there: http://127.0.0.1:8888/callback).
SPOTIFY_CLIENT_ID=

# Where snapshots, tokens and caches live, and where reports are written.
# Inside Docker these are overridden to /app/data and /app/reports.
DATA_DIR=data
REPORTS_DIR=reports
